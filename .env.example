# PrismAI — Required Python environment variables
# Copy this file to .env and fill in your real keys
# Never commit .env — it is gitignored

GEMINI_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# ── Optional ───────────────────────────────────────────────────────────────
# Override model ids when a provider renames/retires a model (see backend/config.py)
# PRISMAI_MODEL_SMART=groq/openai/gpt-oss-120b
# PRISMAI_MODEL_CODER=groq/qwen/qwen3.8-27b
# PRISMAI_MODEL_FAST=groq/openai/gpt-oss-20b
# PRISMAI_MODEL_GEMINI=gemini/gemini-3.5-flash
# PRISMAI_EMBEDDINGS=off          # skip loading sentence-transformers (saves ~300MB RAM)
# PRISMAI_DB_PATH=/var/data/prismai.db
# FRONTEND_URL=https://your-app.vercel.app,https://your-domain.com
